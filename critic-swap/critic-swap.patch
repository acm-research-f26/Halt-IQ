new file mode 100644
index 0000000..d02d521
--- /dev/null
+++ b/shp/critics.py
@@ -0,0 +1,161 @@
+"""
+critics.py
+
+Swappable critic registry for the Writer→Critic loop.
+
+  default — the original LLM editor (agents.make_critic_node): one call that
+            returns either "APPROVED" or one critique.
+  jev     — Jev (TypeSafe AI) decides approve/revise with a calibrated
+            confidence and returns no text. Only on "revise" does the regular
+            agent LLM write feedback, so approvals cost zero LLM tokens.
+
+Every critic keeps the same node contract: it appends {"draft", "feedback"} to
+history and bumps loop_count. On approval the feedback is exactly "APPROVED",
+so halting.shp_should_halt and every replay policy work unchanged.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import os
+from dataclasses import dataclass
+
+from langchain_core.language_models import BaseChatModel
+from langchain_core.messages import SystemMessage, HumanMessage
+
+from shp.agents import make_critic_node, _format_contexts, _llm_call_with_retry
+
+logger = logging.getLogger(__name__)
+
+CRITIC_CHOICES = ("default", "jev")
+
+# Feedback prompt used only after Jev has already decided "revise", so the
+# APPROVED escape hatch is removed: Jev is the sole approve/revise authority.
+_JEV_FEEDBACK_SYSTEM = """\
+You are a strict, detail-oriented editor. A verifier has already determined that
+the answer below needs revision. Provide ONE specific, actionable critique.
+
+Rules:
+- Give exactly ONE critique in 1-3 sentences. Be precise about what is missing,
+  unsupported, or factually incomplete relative to the context and question.
+- Prioritise substantive gaps: a missing reasoning hop, a claim not supported by
+  the context, an unanswered part of the question, or a factual error.
+- Do NOT nitpick synonyms, style, or wording. Do NOT approve the answer.
+"""
+
+_FALLBACK_FEEDBACK = (
+    "Re-check every claim against the context passages and make each reasoning "
+    "step explicit."
+)
+
+
+@dataclass
+class JevVerdict:
+    decision: str      # "approve" | "revise"
+    confidence: float  # calibrated P(decision is correct), in [0, 1]
+
+    @property
+    def approved(self) -> bool:
+        return self.decision == "approve"
+
+
+class JevClient:
+    """
+    Thin client for Jev. Mock mode returns a deterministic verdict so the whole
+    comparison pipeline runs offline; the real call is not wired yet.
+    """
+
+    def __init__(self, mock: bool = False):
+        self.mock = mock
+
+    def decide(self, question: str, contexts: list, draft: str) -> JevVerdict:
+        if self.mock:
+            return _mock_verdict(draft)
+        # TODO: call the TypeSafe AI Jev endpoint here and map its structured
+        # response onto JevVerdict. Credentials via env (e.g. JEV_API_KEY).
+        raise NotImplementedError(
+            "Real Jev client not wired yet; run with --mock or implement JevClient.decide."
+        )
+
+
+def _mock_verdict(draft: str) -> JevVerdict:
+    """Deterministic stand-in: approval gets likelier in later rounds."""
+    h = (int(hashlib.sha1(draft.encode()).hexdigest(), 16) % 10_000) / 10_000.0
+    try:
+        rnd = int(draft.split("round ")[1].split("]")[0])  # mock drafts carry the round
+    except Exception:
+        rnd = 1
+    p_approve = min(0.95, 0.15 + 0.2 * (rnd - 1))
+    approved = h < p_approve
+    confidence = round(0.5 + 0.5 * abs(h - p_approve) / max(p_approve, 1 - p_approve), 4)
+    return JevVerdict("approve" if approved else "revise", confidence)
+
+
+def make_jev_critic_node(feedback_llm: BaseChatModel | None, jev: JevClient, emit=None):
+    """
+    Return a LangGraph critic node where Jev makes the decision and
+    ``feedback_llm`` writes the critique only when Jev says revise.
+    """
+    _emit = emit or (lambda e: None)
+
+    def critic_node(state: dict) -> dict:
+        scenario   = state.get("scenario", {})
+        draft      = state.get("current_draft", "")
+        loop_count = state.get("loop_count", 0)
+        history    = list(state.get("history", []))
+        question   = scenario.get("question", "") or scenario.get("topic", "")
+        contexts   = scenario.get("contexts", [])
+
+        verdict = jev.decide(question, contexts, draft)
+        llm_calls = 0
+
+        if verdict.approved:
+            feedback = "APPROVED"
+        elif feedback_llm is None:
+            feedback = _FALLBACK_FEEDBACK
+        else:
+            user_content = (
+                f"Question: {question}\n\n"
+                f"Context passages:\n{_format_contexts(contexts)}\n\n"
+                f"Answer Draft:\n{draft}\n\n"
+                "Provide your critique."
+            )
+            response = _llm_call_with_retry(
+                feedback_llm,
+                [SystemMessage(content=_JEV_FEEDBACK_SYSTEM), HumanMessage(content=user_content)],
+                context="Critic[jev-feedback]",
+            )
+            llm_calls = 1
+            feedback = response.content.strip()
+            # The feedback LLM must not override Jev's decision.
+            if feedback.upper().startswith("APPROVED"):
+                feedback = _FALLBACK_FEEDBACK
+
+        logger.info("[Critic:jev] round %d → %s (conf=%.3f)",
+                    loop_count + 1, verdict.decision, verdict.confidence)
+        _emit({
+            "type":        "critic_feedback",
+            "round":       loop_count + 1,
+            "feedback":    feedback,
+            "is_approved": verdict.approved,
+            "confidence":  verdict.confidence,
+        })
+
+        history.append({
+            "draft": draft, "feedback": feedback,
+            "critic_confidence": verdict.confidence, "critic_llm_calls": llm_calls,
+        })
+        return {"history": history, "loop_count": loop_count + 1}
+
+    return critic_node
+
+
+def get_critic_node(name: str, llm: BaseChatModel | None, emit=None, mock: bool = False):
+    """Build the critic node selected by ``--critic`` / the CRITIC env var."""
+    name = name or os.getenv("CRITIC", "default")
+    if name == "default":
+        return make_critic_node(llm, emit)
+    if name == "jev":
+        return make_jev_critic_node(llm, JevClient(mock=mock), emit)
+    raise ValueError(f"Unknown critic '{name}'. Choices: {CRITIC_CHOICES}")
