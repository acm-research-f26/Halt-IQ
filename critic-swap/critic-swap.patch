diff --git a/experiments/compare_critics.py b/experiments/compare_critics.py
new file mode 100644
index 0000000..22b661a
--- /dev/null
+++ b/experiments/compare_critics.py
@@ -0,0 +1,159 @@
+"""
+compare_critics.py
+
+Run the same scenarios once per critic (via run_experiment.run, so trajectories,
+judge cache and rows are reused/resumable) and print one table per critic ×
+halt policy:
+
+    success_rate   fraction of scenarios whose final draft counts as a success
+                   (--success contains: normalized ground truth appears in the
+                   answer; --success is: final IS >= --is-threshold)
+    avg_rounds     mean stop round
+    judge_calls    mean OPERATIONAL RAGAS calls per scenario (one per round for
+                   policies that need IS at runtime; 0 otherwise)
+    critic_llm     mean critic LLM calls per scenario (jev skips it on approve)
+    latency_s      mean writer+critic wall time up to the stop round
+                   (judge time excluded; near zero and meaningless in --mock)
+    final_is       mean Information Score of the final draft
+    ar_mean        mean RAGAS answer_relevancy of the final draft
+    ar_zero_rate   fraction of final drafts with answer_relevancy == 0 (RAGAS
+                   zeroes it for noncommittal answers, which drags final_is down)
+
+Usage (from backend/):
+    python experiments/compare_critics.py --mock --split dev --success is
+    python experiments/compare_critics.py --split dev --critics default jev --limit 10
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import re
+import string
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from shp.config import DEFAULT_PROVIDER, MAX_ROUNDS
+from shp.critics import CRITIC_CHOICES
+from shp.halting import HaltConfig
+from experiments.checkpoint import CheckpointStore
+from experiments.policies import default_policy_suite, ablation_policy_suite
+from experiments.run_experiment import build_argparser, run
+
+
+def _normalize(text: str) -> str:
+    text = text.lower()
+    text = "".join(ch for ch in text if ch not in set(string.punctuation))
+    text = re.sub(r"\b(a|an|the)\b", " ", text)
+    return " ".join(text.split())
+
+
+def _is_success(mode: str, draft: str, ground_truth: str, final_is: float, threshold: float) -> bool:
+    if mode == "is":
+        return final_is >= threshold
+    gt = _normalize(ground_truth)
+    return bool(gt) and f" {gt} " in f" {_normalize(draft)} "
+
+
+def summarize(root: str, policies: list[str], uses_judge: dict[str, bool],
+              success: str, threshold: float) -> list[dict]:
+    store = CheckpointStore(root)
+    rows = [r for r in store.load_rows() if r.policy in policies]
+    trajs: dict = {}
+    out = []
+    for policy in policies:
+        cells = [r for r in rows if r.policy == policy]
+        if not cells:
+            continue
+        succ = rounds = judge = critic_llm = latency = fin_is = ar = ar_zero = 0.0
+        for r in cells:
+            traj = trajs.get(r.scenario_id) or trajs.setdefault(
+                r.scenario_id, store.load_trajectory(r.scenario_id))
+            ran = traj.rounds[:r.stop_round]
+            succ += _is_success(success, ran[-1].draft, traj.ground_truth, r.final_is, threshold)
+            rounds += r.stop_round
+            judge += r.stop_round if uses_judge.get(policy, False) else 0
+            critic_llm += sum(x.critic_llm_calls for x in ran)
+            latency += sum(x.writer_latency_s + x.critic_latency_s for x in ran)
+            fin_is += r.final_is
+            ar += r.answer_relevancy
+            ar_zero += r.answer_relevancy == 0.0
+        n = len(cells)
+        out.append({
+            "policy": policy, "n": n, "success_rate": succ / n, "avg_rounds": rounds / n,
+            "judge_calls": judge / n, "critic_llm": critic_llm / n,
+            "latency_s": latency / n, "final_is": fin_is / n,
+            "ar_mean": ar / n, "ar_zero_rate": ar_zero / n,
+        })
+    return out
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description="Compare critics on identical scenarios")
+    ap.add_argument("--critics", nargs="+", default=list(CRITIC_CHOICES), choices=CRITIC_CHOICES)
+    ap.add_argument("--policies", nargs="+", default=["critic_only", "shp"],
+                    help="Halt policies to report (critic_only isolates the critic's stop decision).")
+    ap.add_argument("--success", choices=["contains", "is"], default="contains")
+    ap.add_argument("--is-threshold", type=float, default=0.65)
+    ap.add_argument("--tag", default=None, help="Run-id prefix (default: derived from split/provider).")
+    ap.add_argument("--out", default=None, help="CSV path (default: results/compare_<tag>.csv).")
+    # Pass-through to run_experiment.
+    ap.add_argument("--scenarios", default="data/scenarios_hotpot.json")
+    ap.add_argument("--split", default="dev", choices=["dev", "test", "all"])
+    ap.add_argument("--provider", default=DEFAULT_PROVIDER, choices=["groq", "openai", "nvidia"])
+    ap.add_argument("--agent-model", default=None)
+    ap.add_argument("--eval-model", default=None)
+    ap.add_argument("--max-rounds", type=int, default=min(6, MAX_ROUNDS))
+    ap.add_argument("--limit", type=int, default=None)
+    ap.add_argument("--mock", action="store_true")
+    args = ap.parse_args()
+
+    tag = args.tag or f"cmp_{args.split}_{args.provider}_mr{args.max_rounds}{'_mock' if args.mock else ''}"
+    halt_cfg = HaltConfig(max_rounds=args.max_rounds)
+    uses_judge = {p.name: p.uses_judge
+                  for p in default_policy_suite(halt_cfg) + ablation_policy_suite(halt_cfg)}
+
+    table = []
+    for critic in args.critics:
+        run_id = f"{tag}_critic-{critic}"
+        run_argv = [
+            "--scenarios", args.scenarios, "--split", args.split, "--provider", args.provider,
+            "--max-rounds", str(args.max_rounds), "--run-id", run_id, "--critic", critic,
+        ]
+        for flag, val in (("--agent-model", args.agent_model), ("--eval-model", args.eval_model),
+                          ("--limit", args.limit)):
+            if val is not None:
+                run_argv += [flag, str(val)]
+        if args.mock:
+            run_argv.append("--mock")
+        run(build_argparser().parse_args(run_argv))
+        for row in summarize(os.path.join("results", run_id), args.policies, uses_judge,
+                             args.success, args.is_threshold):
+            table.append({"critic": critic, **row})
+
+    cols = ["critic", "policy", "n", "success_rate", "avg_rounds", "judge_calls",
+            "critic_llm", "latency_s", "final_is", "ar_mean", "ar_zero_rate"]
+    fmt = {"success_rate": "{:.3f}", "avg_rounds": "{:.2f}", "judge_calls": "{:.2f}",
+           "critic_llm": "{:.2f}", "latency_s": "{:.3f}", "final_is": "{:.4f}",
+           "ar_mean": "{:.4f}", "ar_zero_rate": "{:.3f}"}
+    cell = lambda r, c: fmt.get(c, "{}").format(r[c])
+
+    success_def = (f"final IS >= {args.is_threshold}" if args.success == "is"
+                   else "normalized ground truth contained in final answer")
+    print(f"\nsuccess = {success_def}{'   [MOCK — synthetic, not a result]' if args.mock else ''}\n")
+    print("| " + " | ".join(cols) + " |")
+    print("|" + "|".join("---" for _ in cols) + "|")
+    for r in table:
+        print("| " + " | ".join(cell(r, c) for c in cols) + " |")
+
+    out = args.out or os.path.join("results", f"compare_{tag}.csv")
+    with open(out, "w", encoding="utf-8") as fh:
+        fh.write(",".join(cols) + "\n")
+        for r in table:
+            fh.write(",".join(cell(r, c) for c in cols) + "\n")
+    print(f"\nCSV → {out}")
+
+
+if __name__ == "__main__":
+    main()
